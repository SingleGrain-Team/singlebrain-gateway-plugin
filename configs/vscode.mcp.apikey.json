{
  "inputs": [
    {
      "type": "promptString",
      "id": "singlebrain-api-key",
      "description": "SingleBrain Gateway API key",
      "password": true
    }
  ],
  "servers": {
    "singlebrain": {
      "type": "http",
      "url": "https://gateway.singlebrain.com/mcp",
      "headers": {
        "Authorization": "Bearer ${input:singlebrain-api-key}"
      }
    }
  }
}
